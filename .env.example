# ==============================================================================
# CineMatch — Environment Configuration Example
# Copy this file to `.env` and adjust values for your environment.
# ==============================================================================

# Environment & Server ("production", "development", or "testing")
CINEMATCH_ENV=production
CINEMATCH_HOST=0.0.0.0
CINEMATCH_PORT=5000
CINEMATCH_DEBUG=false
CINEMATCH_LOG_LEVEL=INFO
CINEMATCH_LOG_JSON=false

# Restricted CORS Origins (comma-separated list of allowed origins)
CINEMATCH_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Dataset Configuration
# Path to movies_metadata.csv (defaults to data/movies_metadata.csv or ./movies_metadata.csv)
CINEMATCH_DATASET_PATH=movies_metadata.csv
# Optional path to real user ratings CSV (userId,movieId,rating) for Collaborative Filtering
CINEMATCH_RATINGS_PATH=
# Optional reproducible random sample size (leave empty to process full catalog via sparse matrix)
CINEMATCH_SAMPLE_SIZE=
CINEMATCH_RANDOM_STATE=42

# Demographic Model (IMDB Weighted Rating)
CINEMATCH_DEMOGRAPHIC_QUANTILE=0.90
CINEMATCH_DEMOGRAPHIC_MIN_VOTES=

# Content-Based TF-IDF Feature Limit
CINEMATCH_TFIDF_MAX_FEATURES=25000

# Hybrid Recommendation Weights (automatically normalized to sum to 1.0)
CINEMATCH_HYBRID_WEIGHT_CONTENT=0.65
CINEMATCH_HYBRID_WEIGHT_DEMOGRAPHIC=0.25
CINEMATCH_HYBRID_WEIGHT_COLLABORATIVE=0.10

# API Pagination & Limits
CINEMATCH_DEFAULT_TOP_N=12
CINEMATCH_MAX_TOP_N=50
CINEMATCH_DEFAULT_PAGE_SIZE=20
CINEMATCH_MAX_PAGE_SIZE=100

# External Visual Metadata (Optional TMDB Configuration)
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
